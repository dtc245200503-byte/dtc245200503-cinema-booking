{
 "uid": "cinema-logs",
 "title": "Cinema - Log tập trung (Loki)",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "cinema"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Số dòng log mỗi giây theo dịch vụ",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate({job=\"docker\"}[1m]))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Số dòng log lỗi của backend (5 phút)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({service=\"backend\"} |~ \"(?i)error|exception|traceback\" [5m]))",
     "legendFormat": "lỗi",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Đăng nhập bị chặn 429 (5 phút)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({service=\"nginx\"} |= \"POST /api/auth/login\" |= \"429\" [5m]))",
     "legendFormat": "429",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "logs",
   "title": "Log backend",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"backend\"}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Log truy cập Nginx",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"nginx\"}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ]
}